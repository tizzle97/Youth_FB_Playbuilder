# Copy this file to .env (which should NOT be committed) and fill in real values.
# Example:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key_here

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY

# Stripe billing UI. Must be the lowercase string `true` to enable — anything
# else (including `TRUE`) leaves the Pro card in its "coming soon" state.
# Do not enable in production until BACKLOG B-18/B-21 clear.
# VITE_BILLING_ENABLED=true

# Server-side only. Used by scripts/ (seed-library, one-off migrations) — never
# by src/. NEVER give this a VITE_ prefix: Vite inlines every VITE_* var into
# the public bundle, which would publish a key that bypasses all RLS.
# Keep .env at chmod 600. See supabase/SECRETS.md for rotation.
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# Note: Google Analytics is NOT configured via env. The GA4 measurement ID is
# a constant in src/lib/analytics.ts, and gtag.js only loads after the visitor
# accepts the cookie consent banner.
